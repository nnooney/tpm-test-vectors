//  If a TPM requires TPM2_Startup() and another command is received, or if the
//  TPM receives TPM2_Startup() when it is not required, the TPM shall return
//  TPM_RC_INITIALIZE.
TpmTestVector(
  name: "[TPM2_Startup] other commands not allowed when startup is needed",
  spec_versions: [
    184,
  ],
  test_sequence: [
    SendCommand(
      step: "TPM2_GetCapability before startup",
      input: "8001_00000016_0000017a_00000006_00000201_00000001",
      response: "8001_0000000a_00000100",
    ),
  ]
)
