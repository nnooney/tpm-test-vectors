// On TPM Resume:
//
// • PCR that are specified in a platform-specific specification to be preserved
// on TPM Resume are restored to their saved state and other PCR are set to
// their initial value as determined by a platform-specific specification. For
// constraints, see TPM 2.0 Part 1, H-CRTM before TPM2_Startup() and
// TPM2_Startup() without H-CRTM.
TpmTestVector(
  name: "[TPM2_Startup] Resume handles PCR values",
  spec_versions: [
    184,
  ],
  test_sequence: [
    SendCommand(
      step: "Issue TPM Startup Command",
      input: "8001_0000000c_00000144_0000",
      response: "8001_0000000a_00000000",
    ),
  ]
)
