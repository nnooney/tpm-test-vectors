// If hierarchy is TPM_RH_NULL or nameAlg is TPM_ALG_NULL, a ticket produced
// using the object shall be a NULL Ticket.
//
// If a key is loaded with hierarchy set to TPM_RH_NULL, then
// TPM2_VerifySignature() will produce a NULL Ticket of the required type.
TpmTestVector(
  name: "[TPM2_LoadExternal] creates NULL ticket",
  spec_versions: [
    184,
  ],
  test_sequence: [
  ]
)
