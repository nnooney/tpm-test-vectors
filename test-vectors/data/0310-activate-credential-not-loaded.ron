// TPM2_ActivateCredential enables the association of a credential with an
// object in a way that ensures that the TPM has validated the parameters of the
// credentialed object.
//
// If both the public and private portions of activateHandle and keyHandle are
// not loaded, then the TPM shall return TPM_RC_AUTH_UNAVAILABLE.
TpmTestVector(
  name: "[TPM2_ActivateCredential] objects not loaded",
  spec_versions: [
    184,
  ],
  test_sequence: [
  ]
)
