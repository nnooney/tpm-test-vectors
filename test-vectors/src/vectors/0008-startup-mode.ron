// TPM_CC_Startup (TPM_RC_INITIALIZE).
TpmTestVector(
  name: "[Mode Check] startup mode",
  spec_versions: [
    184,
  ],
  test_sequence: [
    SendCommand(
      step: "Issue command before startup",
      // Command = TPM_SelfTest
      input: "8001_0000000b_00000143_00",
      response: "8001_0000000a_00000100",
    )
  ]
)
