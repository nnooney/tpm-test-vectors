// TPM2_Startup() is always preceded by _TPM_Init, which is the physical
// indication that TPM initialization is necessary because of a system-wide
// reset. TPM2_Startup() is only valid after _TPM_Init.
TpmTestVector(
  name: "[TPM2_Startup] success",
  spec_versions: [
    184,
  ],
  test_sequence: [
    SendCommand(
      step: "Issue TPM Startup Command",
      input: "8001_0000000c_00000144_0000",
      response: "8001_0000000a_00000000",
    ),
  ]
)
